<UserControl x:Class="DarkestDungeonSaveEditor.App.QuestBoardPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarkestDungeonSaveEditor.App"
             MinHeight="250" Background="Transparent" Focusable="True"
             FontFamily="{local:Font Body}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Loaded="Preview_Loaded" IsVisibleChanged="Preview_IsVisibleChanged"
             IsEnabledChanged="Preview_IsEnabledChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MapViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BoardMapButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#503F3418" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="PreviewRoot" Background="#B0050505">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource StoneBandBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="BoardStatusText" Grid.Column="0" Margin="16,0,12,0" VerticalAlignment="Center"
                           FontFamily="{local:Font Heading}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                           Text="{local:Text QuestBoard_PreviewLabel}" TextTrimming="CharacterEllipsis" ToolTip="{local:Text QuestBoard_PreviewLabel}" />
                <StackPanel Grid.Column="1" Margin="8,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExpandButton" Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="118" MinHeight="32" Margin="3,0,11,0" Padding="12,4" FontSize="13"
                            Content="{local:Text QuestBoard_Expand}" Click="Expand_Click" />
                    <Button x:Name="ZoomOutButton" Style="{StaticResource MapToolbarButtonStyle}" Content="－" Click="ZoomOut_Click" ToolTip="{local:Text BattleMapView_003}" />
                    <TextBlock x:Name="ZoomText" Width="58" Text="100%" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource MapToolbarButtonStyle}" Content="＋" Click="ZoomIn_Click" ToolTip="{local:Text BattleMapView_004}" />
                    <Button x:Name="ResetZoomButton" Style="{StaticResource MapToolbarButtonStyle}" MinWidth="62" Content="100%" Click="ResetZoom_Click" ToolTip="{local:Text BattleMapView_005}" />
                    <Button x:Name="FitButton" Style="{StaticResource MapToolbarButtonStyle}" MinWidth="82" Content="{local:Text BattleMapView_006}" Click="Fit_Click" ToolTip="{local:Text BattleMapView_007}" />
                </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="BoardBody" Visibility="Collapsed" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="240" MaxWidth="280" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DetailsHost" Margin="0,1,0,1" Background="Black" BorderBrush="#4A514F" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="RewardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Show the native quest/reward area without the estate heading or unused bottom padding. -->
                    <Viewbox x:Name="DetailsViewbox" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="6,8">
                        <Canvas x:Name="DetailsViewport" Width="400" Height="610" ClipToBounds="True">
                            <Canvas x:Name="DetailsCanvas" Canvas.Top="-140" Width="400" Height="843">
                                <Image x:Name="DetailBackdrop" Width="400" Height="843" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas x:Name="EstateMapHeader" Width="400" Height="140" Visibility="Collapsed">
                                    <Image x:Name="EstateMapIcon" Canvas.Left="22" Canvas.Top="20" Width="108" Height="108" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Canvas.Left="142" Canvas.Top="54" Width="238" Text="{local:Text QuestBoard_EstateMap}"
                                               FontFamily="{local:Font Heading}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" />
                                </Canvas>
                                <TextBlock x:Name="QuestName" Canvas.Left="28" Canvas.Top="142" Width="348" Height="38" TextAlignment="Center"
                                           FontFamily="{local:Font Heading}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="QuestDescription" Canvas.Left="34" Canvas.Top="194" Width="340" MaxHeight="174"
                                           FontSize="23" LineHeight="30" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="CampingText" Canvas.Left="58" Canvas.Top="389" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" />
                                <TextBlock x:Name="QuestSpecs" Canvas.Left="126" Canvas.Top="389" Width="248" FontSize="21" TextAlignment="Right" />
                                <TextBlock Canvas.Left="34" Canvas.Top="432" Text="{local:Text QuestBoard_Objective}" FontSize="23" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="QuestObjective" Canvas.Left="50" Canvas.Top="463" Width="320" MaxHeight="54" FontSize="21" LineHeight="25" TextWrapping="Wrap" />
                                <TextBlock x:Name="RewardHeading" Canvas.Left="28" Canvas.Top="532" Width="348" Text="{local:Text QuestBoard_Rewards}"
                                           FontFamily="{local:Font Heading}" FontSize="29" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" TextAlignment="Center" />
                                <ScrollViewer x:Name="RewardInventoryScroll" Canvas.Left="30" Canvas.Top="590" Width="348" Height="146"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="RewardPanel" Width="320" ItemWidth="80" ItemHeight="160" HorizontalAlignment="Center" />
                                </ScrollViewer>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="0,1,0,1">
                <!-- The viewport is inside the frame, so fitting never includes the frame's pixels. -->
                <Border x:Name="MapViewport" ClipToBounds="True" Background="#100D0C"
                        SizeChanged="Viewport_SizeChanged" PreviewMouseWheel="Viewport_MouseWheel"
                        PreviewMouseRightButtonDown="Viewport_RightDown" PreviewMouseRightButtonUp="Viewport_RightUp"
                        PreviewMouseMove="Viewport_MouseMove" LostMouseCapture="Viewport_LostMouseCapture"
                        MouseRightButtonUp="Viewport_ShowRegionMenu">
                    <Canvas x:Name="MapSurface" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas.Clip><RectangleGeometry Rect="0,0,1920,1080" /></Canvas.Clip>
                        <Canvas.RenderTransform>
                            <TransformGroup><ScaleTransform x:Name="MapScale" /><TranslateTransform x:Name="MapOffset" /></TransformGroup>
                        </Canvas.RenderTransform>
                        <Image x:Name="MapBackdrop" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Stretch="Uniform"
                               IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="MapCanvas" Width="1920" Height="1080" Background="Transparent" />
                    </Canvas>
                </Border>
                <Border x:Name="MissingArtNotice" Background="#E0090807" Padding="16" Margin="24" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{local:Text QuestBoard_MissingArt}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GoldBrush}" />
                </Border>
                <ComboBox x:Name="UnpositionedQuests" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MinWidth="220" MaxWidth="400" Visibility="Collapsed" DisplayMemberPath="Label" SelectedValuePath="Key"
                          ToolTip="{local:Text QuestBoard_Unpositioned}" SelectionChanged="UnpositionedQuests_SelectionChanged"
                          MouseRightButtonUp="UnpositionedQuests_ShowMenu" />
            </Grid>
            <!-- Draw the shared edge above both panes, including while the map is zoomed or panned. -->
            <Border x:Name="BoardOutline" Grid.ColumnSpan="2" Panel.ZIndex="1" IsHitTestVisible="False"
                    BorderBrush="#4A514F" BorderThickness="0,1,0,1" />
        </Grid>
        <Grid x:Name="ProfileRequiredPanel" Grid.Row="1" Background="#F0030303">
            <Border Background="#B8050505" BorderBrush="#4A514F" BorderThickness="0,1,0,1" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
                <TextBlock Text="{local:Text QuestBoard_Title}" FontFamily="{local:Font Heading}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="BoardEmptyText" Text="{local:Text QuestBoard_LoadFirst}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,13,0,0" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
