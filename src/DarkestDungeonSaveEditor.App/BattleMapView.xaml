<UserControl x:Class="DarkestDungeonSaveEditor.App.BattleMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:local="clr-namespace:DarkestDungeonSaveEditor.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="600"
             MinHeight="360"
             Background="Transparent"
             Focusable="True"
             Loaded="BattleMapView_Loaded"
             SizeChanged="BattleMapView_SizeChanged"
             PreviewMouseWheel="BattleMapView_PreviewMouseWheel"
             PreviewMouseRightButtonDown="BattleMapView_PreviewMouseRightButtonDown"
             PreviewMouseRightButtonUp="BattleMapView_PreviewMouseRightButtonUp"
             PreviewMouseMove="BattleMapView_PreviewMouseMove">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MapViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#B0050505">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource StoneBandBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  Margin="16,0,12,0"
                  ClipToBounds="True"
                  VerticalAlignment="Center">
                <TextBlock x:Name="MapTitleTextBlock"
                           FontFamily="{local:Font Heading}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"
                           Text="{local:Text BattleMapView_ProfileLifecycle_025}" />
            </Grid>
            <StackPanel Grid.Column="1"
                        Margin="8,0,12,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ForceCompleteQuestButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinHeight="32"
                        Margin="3,0,4,0"
                        Padding="12,4"
                        FontSize="13"
                        Content="{local:Text QuestCompletion_Button}"
                        ToolTip="{local:Text QuestCompletion_Tooltip}"
                        IsEnabled="False"
                        Click="ForceCompleteQuestButton_Click" />
                <Button x:Name="ForceTownButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="118"
                        MinHeight="32"
                        Margin="3,0,11,0"
                        Padding="12,4"
                        FontSize="13"
                        Content="{local:Text BattleMapView_001}"
                        ToolTip="{local:Text BattleMapView_002}"
                        IsEnabled="False"
                        Click="ForceTownButton_Click" />
                <Button x:Name="ZoomOutButton"
                        Style="{StaticResource MapToolbarButtonStyle}"
                        Content="－"
                        ToolTip="{local:Text BattleMapView_003}"
                        Click="ZoomOutButton_Click" />
                <TextBlock x:Name="ZoomTextBlock"
                           Width="58"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource GoldBrush}"
                           FontWeight="Bold"
                           Text="100%" />
                <Button x:Name="ZoomInButton"
                        Style="{StaticResource MapToolbarButtonStyle}"
                        Content="＋"
                        ToolTip="{local:Text BattleMapView_004}"
                        Click="ZoomInButton_Click" />
                <Button x:Name="ResetZoomButton"
                        Style="{StaticResource MapToolbarButtonStyle}"
                        MinWidth="62"
                        Content="100%"
                        ToolTip="{local:Text BattleMapView_005}"
                        Click="ResetZoomButton_Click" />
                <Button x:Name="FitMapButton"
                        Style="{StaticResource MapToolbarButtonStyle}"
                        MinWidth="82"
                        Content="{local:Text BattleMapView_006}"
                        ToolTip="{local:Text BattleMapView_007}"
                        Click="FitMapButton_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="MapViewport"
                Grid.Row="1"
                Background="#F0030303"
                BorderBrush="#4A514F"
                BorderThickness="0,1,0,1"
                ClipToBounds="True"
                Cursor="Arrow">
            <Grid>
                <Canvas x:Name="MapCanvas"
                        Width="672"
                        Height="416"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Visibility="Collapsed"
                        SnapsToDevicePixels="True">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="MapTranslateTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>

                <Grid x:Name="EmptyStatePanel" Background="#B8050505">
                    <StackPanel Width="520"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyStateTitleTextBlock"
                                   HorizontalAlignment="Center"
                                   FontFamily="{local:Font Heading}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   Text="{local:Text BattleMapView_008}" />
                        <TextBlock x:Name="EmptyStateTextBlock"
                                   Margin="0,13,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   LineHeight="22"
                                   Text="{local:Text BattleMapView_009}" />
                    </StackPanel>
                </Grid>

                <Border x:Name="PrototypeBadge"
                        Margin="12"
                        Padding="10,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#D4511112"
                        BorderBrush="{StaticResource AccentStrongBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PrototypeBadgeTextBlock"
                               Foreground="{StaticResource GoldBrush}"
                               FontWeight="Bold"
                               Text="{local:Text BattleMapView_Assets_001}" />
                </Border>

            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="#D0090908">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MapSelectionTextBlock"
                       Grid.Column="0"
                       Margin="14,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="{local:Text BattleMapView_010}" />
            <TextBlock x:Name="LiveStatusTextBlock"
                       Grid.Column="1"
                       Margin="12,0,14,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Text="{local:Text BattleMapView_ProfileLifecycle_005}" />
        </Grid>
    </Grid>
</UserControl>
