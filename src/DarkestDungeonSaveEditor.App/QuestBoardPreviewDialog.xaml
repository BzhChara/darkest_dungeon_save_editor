<Window x:Class="DarkestDungeonSaveEditor.App.QuestBoardPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkestDungeonSaveEditor.App"
        Width="1180" Height="720" MinWidth="900" MinHeight="560"
        Title="{local:Text QuestBoard_SelectTask}" Icon="Assets/save-editor.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppTextureBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{local:Font Body}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource AppTextureBrush}">
    <Border Margin="8" Background="#90050505" BorderThickness="1" BorderBrush="{StaticResource GoldDarkBrush}">
        <Border Margin="3" BorderThickness="1" BorderBrush="#4B5351">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Padding="21,9" Background="{StaticResource HeaderBrush}" BorderBrush="#59615E" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Heading" Style="{StaticResource PageTitleStyle}" FontSize="27" />
                        <TextBlock x:Name="CategoryText" Style="{StaticResource KickerTextStyle}" Margin="1,2,0,0" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="16,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{local:Text QuestBoard_Difficulty}" Style="{StaticResource FieldLabelStyle}" Margin="2,0,10,0" />
                    <ComboBox x:Name="DifficultyChoice" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectionChanged="DifficultyChoice_SelectionChanged" Margin="0" />
                    <TextBlock Grid.Column="2" Text="{local:Text BattleEncounterSelectionDialog_023}" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0" />
                    <TextBox x:Name="SearchTextBox" Grid.Column="3" TextChanged="SearchTextBox_TextChanged" Margin="0" />
                    <TextBlock x:Name="CountTextBlock" Grid.Column="4" Margin="16,0,2,0" VerticalAlignment="Center"
                               Foreground="{StaticResource GoldBrush}" FontWeight="Bold" />
                </Grid>
                <DataGrid x:Name="ChoiceGrid" Grid.Row="2" Margin="16,0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="58"
                          SelectionChanged="ChoiceGrid_SelectionChanged" MouseDoubleClick="ChoiceGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="72">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Icon}" Margin="4" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{local:Text QuestBoard_TaskType}" Width="*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Choice.Id}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:Text QuestBoard_Difficulty}" Binding="{Binding Difficulty}" Width="130" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text QuestBoard_Length}" Binding="{Binding Length}" Width="100" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="SelectionTextBlock" Grid.Row="3" Margin="18,10,18,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{local:Text QuestBoard_SelectionHint}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="4" Margin="16,14" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButtonStyle}" MinWidth="104" Content="{local:Text QuestBoard_Cancel}" IsCancel="True" Margin="0,0,10,0" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Margin="0" Content="{local:Text QuestBoard_Confirm}" IsDefault="True" IsEnabled="False" Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
    </Grid>
</Window>
