<Window x:Class="DarkestDungeonSaveEditor.App.InitialQuirkSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择初始怪癖"
        Width="1220"
        Height="740"
        MinWidth="900"
        MinHeight="560"
        Icon="Assets/save-editor.ico"
        Background="{StaticResource AppTextureBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="SimHei, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppTextureBrush}">
        <Border Margin="8"
                Background="#E8050505"
                BorderBrush="{StaticResource GoldDarkBrush}"
                BorderThickness="1">
            <Border Margin="3" BorderBrush="#4B5351" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="21,10"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="#59615E"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="29" Text="初始怪癖" />
                    <TextBlock Margin="1,2,0,0" Style="{StaticResource KickerTextStyle}"
                               Text="人物生成  ·  可选设置" />
                </StackPanel>
                <Border Grid.Column="1" Padding="15,8" VerticalAlignment="Center"
                        Background="{StaticResource OliveBandBrush}"
                        BorderBrush="#777144"
                        BorderThickness="1" CornerRadius="0">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}"
                                   FontFamily="SimSun, Microsoft YaHei UI" FontSize="15" FontWeight="Bold"
                                   Text="默认保持空白" />
                        <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                   Text="只写入你主动选择的项目" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

                    <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource OpenPanelStyle}"
                    BorderThickness="0" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" Style="{StaticResource OlivePanelHeaderStyle}"
                                    Content="写入规则" />
                    <TextBlock Grid.Row="1" Margin="15,10,15,11" TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}"
                               Text="可验证为安全直写的自然怪癖、固定/特殊怪癖和疾病均可选择，编辑器不限制怪癖对应的职业。正负怪癖各最多 5 个，疾病单独最多 3 个；进化怪癖在马车中按实测样本写入倒计时 0。需要存档上下文和未验证 HP 规则仍不可勾选，怪癖互斥会随当前选择更新。" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource OpenPanelStyle}"
                    BorderThickness="0" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" Style="{StaticResource RedPanelHeaderStyle}"
                                    Content="怪癖目录" />
                    <Grid Grid.Row="1" Margin="12,9,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="4,0,9,0"
                                   Style="{StaticResource FieldLabelStyle}" Text="筛选" />
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="0"
                                 TextChanged="SearchTextBox_TextChanged"
                                 ToolTip="按怪癖 ID、中英文名、类别、来源、HP 规则或不可用原因筛选" />
                        <TextBlock x:Name="SelectionSummaryTextBlock" Grid.Column="2"
                                   Margin="18,0,4,0" VerticalAlignment="Center"
                                   TextAlignment="Right" TextWrapping="Wrap"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>

            <DataGrid x:Name="QuirkGrid" Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" Width="52" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsSelectable}"
                                              ToolTip="{Binding UnavailableReason}"
                                              ToolTipService.ShowOnDisabled="True"
                                              Click="QuirkCheckBox_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="怪癖 ID" Binding="{Binding Id}" Width="1.2*" MinWidth="135" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="中文名" Binding="{Binding ChineseName}" Width="0.85*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="English" Binding="{Binding EnglishName}" Width="0.95*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="目录类别" Binding="{Binding Kind}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="类型" Binding="{Binding Polarity}" Width="58" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="写入状态" Binding="{Binding WriteStatus}" Width="92" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="HP 修正" Binding="{Binding MaxHpSummary}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="1.2*" MinWidth="135" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="不可用原因" Binding="{Binding UnavailableReason}" Width="1.8*" MinWidth="190" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="ValidationTextBlock" Grid.Row="3"
                       Margin="0,10,0,0" Padding="12,9"
                       Background="#421314" Foreground="{StaticResource DangerBrush}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" MinWidth="110" Margin="0"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="清空选择" Click="Clear_Click" />
                <Button Grid.Column="2" MinWidth="104" Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="取消" IsCancel="True" Click="Cancel_Click" />
                <Button Grid.Column="3" MinWidth="126" Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="确认选择" IsDefault="True" Click="Ok_Click" />
            </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
