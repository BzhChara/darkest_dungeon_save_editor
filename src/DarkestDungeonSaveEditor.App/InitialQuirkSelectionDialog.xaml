<Window x:Class="DarkestDungeonSaveEditor.App.InitialQuirkSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:DarkestDungeonSaveEditor.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Text InitialQuirkSelectionDialog_027}"
        Width="1220"
        Height="740"
        MinWidth="900"
        MinHeight="560"
        Icon="Assets/save-editor.ico"
        Background="{StaticResource AppTextureBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{x:Static local:EditorTypography.Body}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppTextureBrush}">
        <Border Margin="8"
                Background="#90050505"
                BorderBrush="{StaticResource GoldDarkBrush}"
                BorderThickness="1">
            <Border Margin="3" BorderBrush="#4B5351" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="21,10"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="#59615E"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="29" Text="{local:Text InitialQuirkSelectionDialog_028}" />
                    <TextBlock Margin="1,2,0,0" Style="{StaticResource KickerTextStyle}"
                               Text="{local:Text InitialQuirkSelectionDialog_029}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="15,8" VerticalAlignment="Center"
                        Background="{StaticResource OliveBandBrush}"
                        BorderBrush="#777144"
                        BorderThickness="1" CornerRadius="0">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}"
                                   FontFamily="{x:Static local:EditorTypography.Heading}" FontSize="15" FontWeight="Bold"
                                   Text="{local:Text InitialQuirkSelectionDialog_030}" />
                        <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                   Text="{local:Text InitialQuirkSelectionDialog_031}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

                    <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource OpenPanelStyle}"
                    BorderThickness="0" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" Style="{StaticResource RedPanelHeaderStyle}"
                                    Content="{local:Text InitialQuirkSelectionDialog_032}" />
                    <Grid Grid.Row="1" Margin="12,9,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="4,0,9,0"
                                   Style="{StaticResource FieldLabelStyle}" Text="{local:Text BattleEncounterSelectionDialog_023}" />
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="0"
                                 TextChanged="SearchTextBox_TextChanged"
                                 ToolTip="{local:Text InitialQuirkSelectionDialog_033}" />
                        <TextBlock x:Name="SelectionSummaryTextBlock" Grid.Column="2"
                                   ToolTip="{local:Text InitialQuirkSelectionDialog_034}"
                                   Margin="18,0,4,0" VerticalAlignment="Center"
                                   TextAlignment="Right" TextWrapping="Wrap"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>

            <DataGrid x:Name="QuirkGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{local:Text App_002}" Width="66" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              IsEnabled="{Binding IsSelectable}"
                                              Click="QuirkCheckBox_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:Text InitialQuirkSelectionDialog_035}" Binding="{Binding Id}" Width="1.2*" MinWidth="135" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text BattleRoomAttachmentSelectionDialog_009}" Binding="{Binding ChineseName}" Width="0.85*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="English" Binding="{Binding EnglishName}" Width="0.95*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text InitialQuirkSelectionDialog_036}" Binding="{Binding Kind}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text InitialQuirkSelectionDialog_037}" Binding="{Binding Polarity}" Width="58" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text InitialQuirkSelectionDialog_038}" Binding="{Binding WriteStatus}" Width="92" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text InitialQuirkSelectionDialog_039}" Binding="{Binding MaxHpSummary}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text BattleEncounterSelectionDialog_029}" Binding="{Binding Source}" Width="1.2*" MinWidth="135" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="{local:Text InitialQuirkSelectionDialog_040}" Binding="{Binding UnavailableReason}" Width="1.8*" MinWidth="190" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="ValidationTextBlock" Grid.Row="2"
                       Margin="0,10,0,0" Padding="12,9"
                       Background="#421314" Foreground="{StaticResource DangerBrush}"
                       FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" MinWidth="110" Margin="0"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="{local:Text InitialQuirkSelectionDialog_041}" Click="Clear_Click" />
                <Button Grid.Column="2" MinWidth="104" Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="{local:Text BattleEncounterSelectionDialog_030}" IsCancel="True" Click="Cancel_Click" />
                <Button Grid.Column="3" MinWidth="126" Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{local:Text InitialQuirkSelectionDialog_042}" IsDefault="True" Click="Ok_Click" />
            </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
