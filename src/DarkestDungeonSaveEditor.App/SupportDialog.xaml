<Window x:Class="DarkestDungeonSaveEditor.App.SupportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赞助支持"
        Width="580" Height="830"
        Icon="Assets/save-editor.ico"
        Background="{StaticResource AppTextureBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="SimHei, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppTextureBrush}">
        <Border Margin="8" Background="#ED050505"
                BorderBrush="{StaticResource GoldDarkBrush}" BorderThickness="1">
            <Border Margin="3" BorderBrush="#4B5351" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="68" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="{StaticResource OliveBandBrush}" />
                        <Border Background="{StaticResource BandTextureBrush}" />
                        <Border Background="{StaticResource BandVignetteBrush}" />
                        <StackPanel Margin="24,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="☕" FontFamily="Segoe UI Symbol" FontSize="32"
                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="赞助支持" FontSize="25" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}" />
                                <TextBlock Margin="0,3,0,0" Text="感谢支持暗黑地牢存档编辑器"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="24,18,24,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="如果这个工具对你有帮助，欢迎请我喝杯咖啡。"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" />
                            <TextBlock Margin="0,7,0,0" Text="赞助完全自愿，不影响任何功能。"
                                       Style="{StaticResource MutedTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <Image x:Name="AlipayCodeImage" Margin="0,16,0,12"
                                   Width="320" MaxWidth="320" Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   Source="Assets/support-alipay.jpg"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="支付宝收款码，赞助金额 10 元" />
                            <TextBlock Text="支付宝扫码赞助 ¥10" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="CloseButton" Grid.Row="2" Width="112" Margin="0,8,20,12"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}" Content="关闭"
                            IsDefault="True" IsCancel="True" Click="Close_Click" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
