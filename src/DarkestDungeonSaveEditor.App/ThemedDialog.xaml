<Window x:Class="DarkestDungeonSaveEditor.App.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680"
        MinWidth="560"
        MaxWidth="820"
        MaxHeight="720"
        SizeToContent="Height"
        Icon="Assets/save-editor.ico"
        Background="{StaticResource AppTextureBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="SimHei, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ImageBrush x:Key="DialogParchmentBrush"
                    ImageSource="Assets/dialog-parchment.png"
                    AlignmentX="Center"
                    AlignmentY="Center"
                    Stretch="UniformToFill" />
    </Window.Resources>

    <Grid Background="{StaticResource AppTextureBrush}">
        <Border Margin="8"
                Background="#ED050505"
                BorderBrush="{StaticResource GoldDarkBrush}"
                BorderThickness="1">
            <Border Margin="3"
                    BorderBrush="#4B5351"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="72" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border x:Name="HeaderBackdrop"
                                Background="{StaticResource RedBandBrush}" />
                        <Border Background="{StaticResource BandTextureBrush}" />
                        <Border Background="{StaticResource BandVignetteBrush}" />
                        <Grid Margin="20,9,20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="KindMarkerTextBlock"
                                       Width="40"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FontFamily="SimSun, Microsoft YaHei UI"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="!" />

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderTitleTextBlock"
                                           FontFamily="SimSun, Microsoft YaHei UI"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="KindLabelTextBlock"
                                           Margin="1,2,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="警示  /  WARNING" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="ParchmentSurfaceBorder"
                            Grid.Row="1"
                            Margin="20,18,20,16"
                            Background="{StaticResource DialogParchmentBrush}"
                            BorderThickness="0">
                        <Grid>
                            <Border Background="#18F6DFA8" />
                            <ScrollViewer MaxHeight="390"
                                          Padding="26,24"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <TextBlock x:Name="MessageTextBlock"
                                           AutomationProperties.Name="弹窗信息"
                                           Foreground="#24170E"
                                           FontFamily="SimHei, Microsoft YaHei UI"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           LineHeight="24"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Margin="16,8,16,12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Width="112"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="返回"
                                Click="Cancel_Click" />
                        <Button x:Name="ConfirmButton"
                                Width="112"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="确认"
                                Click="Confirm_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
