<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The cancellation contracts launch this host as an isolated codec process. -->
    <UseAppHost>true</UseAppHost>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DarkestDungeonSaveEditor.Core\DarkestDungeonSaveEditor.Core.csproj" />
    <ProjectReference Include="..\..\src\DarkestDungeonSaveEditor.App\DarkestDungeonSaveEditor.App.csproj" />
  </ItemGroup>
</Project>
